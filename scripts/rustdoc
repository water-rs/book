#!/bin/bash
set -euo pipefail
shopt -s nullglob

# rustdoc wrapper for `mdbook test`.
#
# mdbook invokes `rustdoc <chapter>.md --test` for every chapter containing a
# Rust fence. Compiled (non-`ignore`) fences reference the `waterui` facade, so
# this wrapper maps each facade crate built by the book package (Cargo.toml at
# the repo root — its features decide what exists) to an `--extern` flag.
#
# Version probes must not trigger any build work.
for arg in "$@"; do
  case "$arg" in
    -V|--version|--print=*)
      exec "$(rustup which rustdoc)" "$@"
      ;;
  esac
done

repo_dir=$(cd "$(dirname "$0")/.." && pwd)
actual_rustdoc=$(rustup which rustdoc)
deps_dir="$repo_dir/target/debug/deps"

find_artifact() {
  local crate="$1"
  local base="lib${crate//-/_}-*"
  for candidate in "$deps_dir"/${base}.rlib \
                   "$deps_dir"/${base}.so \
                   "$deps_dir"/${base}.dll \
                   "$deps_dir"/${base}.dylib; do
    echo "$candidate"
    return
  done
  echo ""
}

# The facade must exist; build the book package (not the waterui workspace)
# to populate the shared target directory with the book's feature set.
if [ -z "$(find_artifact waterui)" ]; then
  (cd "$repo_dir" && cargo build >/dev/null)
fi
if [ -z "$(find_artifact waterui)" ]; then
  echo "missing artifact for waterui after cargo build" >&2
  exit 1
fi

need_edition=1
skip_next=0
for arg in "$@"; do
  if [ "$skip_next" -eq 1 ]; then
    need_edition=0
    break
  fi
  case "$arg" in
    --edition)
      need_edition=0
      skip_next=1
      ;;
    --edition=*)
      need_edition=0
      break
      ;;
  esac
done

extra_flags=()
if [ "$need_edition" -eq 1 ]; then
  extra_flags+=("--edition=2024")
fi
extra_flags+=("-L" "dependency=$deps_dir")

# Crates not built under the book's features (e.g. `waterui-webview`) are
# skipped: a compiled fence that needs one fails loudly in rustdoc with a
# missing-crate error, which is the honest signal to add the feature.
crates=(
  waterui
  waterui-core
  waterui-navigation
  waterui-form
  waterui-media
  waterui-text
  waterui-layout
  waterui-controls
  waterui-graphics
  waterui-icon
  waterui-locale
  waterui-webview
  waterui-map
  waterui-barcode
  waterui-particle
  waterui-chart
  waterui-macros
)
for crate in "${crates[@]}"; do
  file=$(find_artifact "$crate")
  if [ -n "$file" ]; then
    extra_flags+=("--extern" "${crate//-/_}=$file")
  fi
done

exec "$actual_rustdoc" "$@" "${extra_flags[@]}"
