#!/bin/bash
set -euo pipefail

# rustdoc wrapper for `mdbook test`.
#
# mdbook invokes `rustdoc <chapter>.md --test` for every chapter containing a
# Rust fence. Compiled (non-`ignore`) fences reference the `waterui` facade
# (and `waterui-testing`), so this wrapper maps each of those crates, as built
# by the book package (Cargo.toml at the repo root — its features decide what
# exists), to an `--extern` flag.
#
# Version probes must not trigger any build work.
for arg in "$@"; do
  case "$arg" in
    -V|--version|--print=*)
      exec "$(rustup which rustdoc)" "$@"
      ;;
  esac
done

repo_dir=$(cd "$(dirname "$0")/.." && pwd)
actual_rustdoc=$(rustup which rustdoc)
deps_dir="$repo_dir/target/debug/deps"

# Build the book package's tests (not the waterui workspace) so the target
# directory holds the facade with the book's feature set and the
# `waterui-testing` dev-dependency, and take each crate's artifact from the
# paths Cargo reports for this build. `deps/` keeps one `libwaterui-*.rlib` per
# feature set ever built there, so a filename glob can link a facade that lacks
# the book's features.
artifacts=$(cd "$repo_dir" && cargo test --locked --no-run --message-format=json)

find_artifact() {
  local crate="${1//-/_}"
  jq -r --arg crate "$crate" '
    select(.reason == "compiler-artifact" and .target.name == $crate)
    | .filenames[] | select(endswith(".rlib"))' <<<"$artifacts" | tail -n 1
}

for crate in waterui waterui-testing; do
  if [ -z "$(find_artifact "$crate")" ]; then
    echo "cargo test --no-run reported no rlib for $crate" >&2
    exit 1
  fi
done

# WaterUI's proc macros locate the `waterui` and `waterui-testing` crates
# through the manifest `CARGO_MANIFEST_DIR` names, and the widget and preview
# export macros name their symbols after the package. rustdoc runs outside
# Cargo, so give every fence the book package's identity.
export CARGO_MANIFEST_DIR="$repo_dir"
export CARGO_PKG_NAME="waterui-tutorial-book"
export CARGO_CRATE_NAME="waterui_tutorial_book"

need_edition=1
skip_next=0
for arg in "$@"; do
  if [ "$skip_next" -eq 1 ]; then
    need_edition=0
    break
  fi
  case "$arg" in
    --edition)
      need_edition=0
      skip_next=1
      ;;
    --edition=*)
      need_edition=0
      break
      ;;
  esac
done

extra_flags=()
if [ "$need_edition" -eq 1 ]; then
  extra_flags+=("--edition=2024")
fi
extra_flags+=("-L" "dependency=$deps_dir")

# Compiled fences import only the `waterui` facade and, in the testing
# chapters, `waterui-testing`; everything else reaches them through the facade.
# A fence that names any other crate fails loudly in rustdoc with a
# missing-crate error, which is the honest signal to route it through the
# facade or mark it `ignore`.
crates=(
  waterui
  waterui-testing
)
for crate in "${crates[@]}"; do
  file=$(find_artifact "$crate")
  if [ -n "$file" ]; then
    extra_flags+=("--extern" "${crate//-/_}=$file")
  fi
done

exec "$actual_rustdoc" "$@" "${extra_flags[@]}"
