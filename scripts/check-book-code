#!/bin/bash
set -euo pipefail

repo_dir=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_dir"

reject_matches() {
  local label="$1"
  local pattern="$2"
  shift 2

  if rg -n "$@" "$pattern" src; then
    echo "found $label in book sources" >&2
    exit 1
  fi
}

reject_matches "stale WaterUI API references" "water create --playground|nami::|WebView::new|Id::new\\(|\\.frame\\(|\\.padding\\([^\\)]|Font::(body|headline|caption)|Color::(white|surface|muted_foreground|foreground)|ios_simulators|crate-type = \\[\\\"staticlib\\\"|Slider::new\\(&|02-hot-reload|02-preview-iteration|02-ffi"
# Facade-covered crates are imported through `waterui::…`. `waterui-map` has no
# facade re-export, so its own path is the real one; the library-authoring
# chapter teaches the crate topology and names inner crates on purpose.
reject_matches "inner crate paths the facade re-exports" "waterui_(webview|barcode|graphics|icon|locale|controls)::" --glob '!**/08-internals/05-library-authoring.md'
reject_matches "placeholder URLs or fake credentials" "example\\.com|prod-key|abc123|MyApp/1\\.0"
reject_underscore_placeholders() {
  # Only prose is checked: inside a fence a leading underscore is the Rust
  # idiom for an unused binding or parameter. In prose, `*_NAME` is a wildcard
  # over a real API family, `__DATA`/`__DWARF`/`__wmeta` are Mach-O section
  # names, `@_extern` is a Swift attribute, and `_water` is the zsh completion
  # file `water completions zsh` writes.
  if awk 'FNR == 1 { fence = 0 } /^[[:space:]]*```/ { fence = !fence; next } !fence { print FILENAME ":" FNR ":" $0 }' $(find src -name '*.md') \
    | rg "(^|[^A-Za-z0-9])_[A-Za-z][A-Za-z0-9_]*" \
    | rg -v '\*_[A-Za-z]|__(DATA|DWARF|wmeta)|@_extern|/_water'; then
    echo "found reader-facing underscore placeholder names in book sources" >&2
    exit 1
  fi
}
reject_underscore_placeholders

scripts/render-book-visuals --check-links
cargo build
cargo test
PATH="$repo_dir/scripts:$PATH" mdbook test
mdbook build
